rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // El usuario puede crear su propio perfil, pero solo con rol 'user' — nunca
      // puede autoasignarse admin (auth.js siempre crea el perfil inicial así).
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'user';
      // Puede actualizar su perfil (nombre, etc.) pero el campo role no puede cambiar
      // por esta vía — asignar/quitar admin se hace a mano desde la consola de Firebase.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role;
    }

    match /catalog/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /clients/{docId} {
      allow read, write: if isSignedIn();
    }

    match /quotations/{docId} {
      allow read, write: if isSignedIn();
    }

    match /_counters/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
